### 1. Using Python Lists


A = [[1, 2], [3, 4]]
B = [[5, 6], [7, 8]]

C = [[A[i][j] + B[i][j] for j in range(2)] for i in range(2)]

print("Matrix A:")
for row in A:
    print(row)

print("Matrix B:")
for row in B:
    print(row)

print("Addition of matrices:")
for row in C:
    print(row)


### 2. Using NumPy Array


import numpy as np

A = np.array([[1, 2], [3, 4]])
B = np.array([[5, 6], [7, 8]])

C = A + B

print("Matrix A:")
print(A)

print("Matrix B:")
print(B)

print("Addition of matrices:")
print(C)


### Output

Matrix A:
[[1 2]
 [3 4]]

Matrix B:
[[5 6]
 [7 8]]

Addition of matrices:
[[ 6  8]
 [10 12]]

